# Copy this file to .env and fill it in. NEVER share your token or client secret.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Optional: your server ID for instant slash-command sync (right-click server > Copy Server ID, needs Developer Mode)
GUILD_ID=
# Real dashboard only (dashboard_server.py) - see HOSTING.md
DISCORD_CLIENT_ID=PASTE_YOUR_APPLICATION_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=PASTE_YOUR_CLIENT_SECRET_HERE
DISCORD_REDIRECT_URI=http://localhost:5000/callback
FLASK_SECRET_KEY=make-up-a-long-random-string
